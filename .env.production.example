APP_NAME=MAKESTA
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://kaderisasi.pelajarnumagetan.or.id/makesta
ASSET_URL=https://kaderisasi.pelajarnumagetan.or.id/makesta

LOG_CHANNEL=stack
LOG_LEVEL=error

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=makesta
DB_USERNAME=makesta
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_COOKIE=makesta_session
SESSION_PATH=/makesta
SESSION_SECURE_COOKIE=true

CACHE_STORE=database
QUEUE_CONNECTION=database

MAIL_MAILER=log
MAIL_FROM_ADDRESS="noreply@pelajarnumagetan.or.id"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"
VITE_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
